<?xml version="1.0" encoding="utf-8"?>
<!-- v4.3 - Card FILL: gradiente #25285A/#1E2348 -> #0F1226, borda #313668, radius 16 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fill_pressed" />
            <stroke android:width="1dp" android:color="@color/fill_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/fill_grad_top"
                android:centerColor="@color/fill_grad_mid"
                android:endColor="@color/fill_grad_bottom" />
            <stroke android:width="1dp" android:color="@color/fill_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
