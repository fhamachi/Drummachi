<?xml version="1.0" encoding="utf-8"?>
<!-- v4.3 - Card VERSO: gradiente #1B283D -> #0E1626, borda #23334D, radius 16 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/part_pressed" />
            <stroke android:width="1dp" android:color="@color/part_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/part_grad_top"
                android:endColor="@color/part_grad_bottom" />
            <stroke android:width="1dp" android:color="@color/part_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
